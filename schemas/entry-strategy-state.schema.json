{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/entry-strategy-state.schema.json",
  "title": "Entry strategy state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticker",
    "mode",
    "current_phase",
    "initial_complete",
    "zones_locked",
    "zones_locked_at_phase",
    "price_zones",
    "zone_revisions",
    "medium_term_structure",
    "short_term_state",
    "event_dominance",
    "price_asymmetry",
    "decision",
    "plan_expiry",
    "next_review"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
    },
    "mode": {
      "enum": [
        "initial",
        "update"
      ]
    },
    "current_phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "initial_complete": {
      "type": "boolean"
    },
    "zones_locked": {
      "type": "boolean"
    },
    "zones_locked_at_phase": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        4,
        null
      ]
    },
    "price_zones": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/zone"
      }
    },
    "zone_revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "medium_term_structure": {
      "enum": [
        "上昇",
        "レンジ",
        "下降",
        "判定困難",
        null
      ]
    },
    "short_term_state": {
      "enum": [
        "上昇加速",
        "通常調整",
        "深い調整",
        "反転試行",
        "反転確認",
        "上抜け試行",
        "上抜け確認",
        "ブレイク失敗",
        "下落加速",
        "判定困難",
        null
      ]
    },
    "event_dominance": {
      "enum": [
        "高",
        "中",
        "低",
        null
      ]
    },
    "price_asymmetry": {
      "enum": [
        "有利",
        "やや有利",
        "中立",
        "やや不利",
        "不利",
        "判定困難",
        null
      ]
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/decision"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_expiry": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "next_review": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "update"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "current_phase": {
            "minimum": 1,
            "maximum": 2
          },
          "initial_complete": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "zones_locked": {
            "const": true
          }
        },
        "required": [
          "zones_locked"
        ]
      },
      "then": {
        "properties": {
          "zones_locked_at_phase": {
            "const": 4
          },
          "price_zones": {
            "minProperties": 1
          },
          "current_phase": {
            "minimum": 4
          }
        }
      },
      "else": {
        "properties": {
          "zones_locked_at_phase": {
            "type": "null"
          },
          "price_zones": {
            "maxProperties": 0
          },
          "zone_revisions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "initial"
          },
          "current_phase": {
            "minimum": 5
          }
        },
        "required": [
          "mode",
          "current_phase"
        ]
      },
      "then": {
        "properties": {
          "zones_locked": {
            "const": true
          },
          "zones_locked_at_phase": {
            "const": 4
          },
          "price_zones": {
            "minProperties": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_id",
        "label",
        "low",
        "high",
        "currency"
      ],
      "properties": {
        "internal_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "currency": {
          "const": "USD"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "old_zone",
        "new_zone",
        "reason",
        "plan_impact"
      ],
      "properties": {
        "phase": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8
        },
        "old_zone": {
          "$ref": "#/$defs/zone"
        },
        "new_zone": {
          "$ref": "#/$defs/zone"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "plan_impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_action",
        "routes",
        "route_priority",
        "allocation",
        "avoided_risk",
        "confidence",
        "primary_reason",
        "primary_short_term_risk",
        "missed_opportunity_risk",
        "return_to_stock_analysis"
      ],
      "properties": {
        "current_action": {
          "enum": [
            "現在購入",
            "条件待ち",
            "購入計画中止",
            "個別銘柄分析へ差し戻し"
          ]
        },
        "routes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "現在値",
              "押し目",
              "上抜け",
              "イベント通過後"
            ]
          }
        },
        "route_priority": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "現在値",
              "押し目",
              "上抜け",
              "イベント通過後"
            ]
          }
        },
        "allocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_purchase_pct",
            "conditional_purchases",
            "pre_event_cap_pct",
            "waiting_pct",
            "waiting_use",
            "rationale",
            "adjustment_factors",
            "unit"
          ],
          "properties": {
            "current_purchase_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "conditional_purchases": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "route",
                  "percent",
                  "condition",
                  "before_event"
                ],
                "properties": {
                  "route": {
                    "enum": [
                      "現在値",
                      "押し目",
                      "上抜け",
                      "イベント通過後"
                    ]
                  },
                  "percent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40
                  },
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "before_event": {
                    "type": "boolean"
                  }
                }
              }
            },
            "pre_event_cap_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "waiting_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "waiting_use": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "押し目用",
                  "上抜け用",
                  "イベント後用",
                  "条件失効により未使用"
                ]
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "adjustment_factors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "中期構造",
                  "短期状態",
                  "ボラティリティ",
                  "相対強度",
                  "イベント支配度",
                  "価格非対称性",
                  "市場環境",
                  "判断確信度",
                  "既存保有の有無"
                ]
              }
            },
            "unit": {
              "const": "target_position_percent"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "waiting_pct": {
                    "const": 0
                  }
                },
                "required": [
                  "waiting_pct"
                ]
              },
              "then": {
                "properties": {
                  "waiting_use": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "waiting_use": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "avoided_risk": {
          "enum": [
            "機会損失",
            "短期下落",
            "均衡"
          ]
        },
        "confidence": {
          "enum": [
            "高",
            "中",
            "低"
          ]
        },
        "primary_reason": {
          "type": "string",
          "minLength": 1
        },
        "primary_short_term_risk": {
          "type": "string",
          "minLength": 1
        },
        "missed_opportunity_risk": {
          "type": "string",
          "minLength": 1
        },
        "return_to_stock_analysis": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "current_action": {
                "const": "個別銘柄分析へ差し戻し"
              }
            },
            "required": [
              "current_action"
            ]
          },
          "then": {
            "properties": {
              "return_to_stock_analysis": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "current_action": {
                "enum": [
                  "現在購入",
                  "条件待ち"
                ]
              }
            },
            "required": [
              "current_action"
            ]
          },
          "then": {
            "properties": {
              "routes": {
                "minItems": 1
              },
              "route_priority": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "current_action": {
                "enum": [
                  "購入計画中止",
                  "個別銘柄分析へ差し戻し"
                ]
              }
            },
            "required": [
              "current_action"
            ]
          },
          "then": {
            "properties": {
              "routes": {
                "maxItems": 0
              },
              "route_priority": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
